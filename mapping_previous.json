  "517": "¡Cuánto me alegra!",
  "518": "Cuando leo en la Biblia",
  "519": "Es el amor divino",
  "520": "Yo temprano busco a Cristo",
  "521": "Bellas las manitas son",
  "522": "Tu reino amo",
  "523": "¡Oh santo Dios!",
  "524": "Ven, alma que lloras",
  "525": "No habrá más llanto allá",
  "526": "Llegaremos al hogar",
  "527": "¿Para quién será el ay?"
}
