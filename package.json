{
  "name": "find_hymn_v2.0",
  "version": "2.0.4",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.damm.findhymn",
    "productName": "FindHymn",
    "icon": "build/icon.ico",
    "files": [
      "**/*",
      "!videos/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "damm-dev",
          "repo": "FindHymn"
        }
      ]
    }
  },
  "keywords": [],
  "author": "Anthony Meléndez",
  "license": "ISC",
  "description": "Aplicación del himnario Adventista del Séptimo día versiones 1962 y 2010",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.7.3",
    "express": "^5.2.1",
    "gsap": "^3.13.0",
    "ip": "^2.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}